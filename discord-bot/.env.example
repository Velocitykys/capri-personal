# Discord Developer Portal > Bot > Reset Token
CAPRI_BOT_TOKEN=put-your-discord-bot-token-here

# OpenAI-compatible API. NVIDIA NIM is the default endpoint.
CAPRI_API_BASE_URL=https://integrate.api.nvidia.com/v1
CAPRI_API_KEY=put-your-provider-api-key-here
CAPRI_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Optional: how long Capri keeps a short follow-up window in a server (seconds)
CAPRI_FOLLOWUP_SECONDS=120
